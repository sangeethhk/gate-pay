# ==============================================================================
# 💳 PayGateway — Production Environment Configuration Template
# ==============================================================================
# Instructions: Copy this file to .env and replace all placeholders before deployment.
# NEVER commit your actual .env file to public version control!
# ==============================================================================

# ─── 1. SERVER CONFIGURATION ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── 2. CRYPTOGRAPHIC SECRETS (Generate with: openssl rand -hex 32) ───────────
JWT_SECRET=replace_with_a_secure_64_character_hex_string_for_jwt_tokens
JWT_PREAUTH_SECRET=replace_with_another_secure_64_character_hex_for_2fa_tokens
ADMIN_SECRET=replace_with_a_strong_admin_registration_master_secret

# ─── 3. DATABASE CONFIGURATION (PostgreSQL / Supabase / Neon / AWS RDS) ──────
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:your_db_password@your_db_host:5432/postgres
DATABASE_SSL=true

# ─── 4. PAYMENT PROVIDER INTEGRATIONS ─────────────────────────────────────────
# Stripe (Optional / Fallback card engine):
# Test keys begin with sk_test_... | Production keys begin with sk_live_...
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# ─── 5. INITIAL PLATFORM SEED CREDENTIALS ─────────────────────────────────────
ADMIN_EMAIL=admin@yourgateway.com
ADMIN_PASSWORD=SetAStrongPassword#2026

# ─── 6. CORS & FRONTEND DOMAIN ────────────────────────────────────────────────
# Set to your production frontend URL (e.g., https://pay.yourdomain.com)
CLIENT_ORIGIN=http://localhost:5173
